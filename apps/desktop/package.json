{
  "name": "@teti/desktop",
  "version": "0.5.1-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:dev:windows": "tauri dev",
    "build:renderer": "vite build",
    "build": "node --experimental-strip-types scripts/build-desktop.ts",
    "build:release": "TETI_BUILD_TYPE=release node --experimental-strip-types scripts/build-desktop.ts",
    "runtime:bundle": "node --experimental-strip-types scripts/bundle-runtime.ts",
    "runtime:windows:install-node": "node --experimental-strip-types scripts/windows-runtime-cli.ts install-node",
    "runtime:windows:stage-rpc": "node --experimental-strip-types scripts/windows-runtime-cli.ts stage-rpc",
    "runtime:windows:verify": "node --experimental-strip-types scripts/windows-runtime-cli.ts verify",
    "runtime:windows:exit-gate": "node --experimental-strip-types scripts/validate-windows-runtime.ts",
    "build-machine:bootstrap": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build-machine.ps1 -Action Bootstrap",
    "build-machine:hydrate": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build-machine.ps1 -Action Hydrate",
    "build-machine:verify": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build-machine.ps1 -Action Verify",
    "windows:release": "node --experimental-strip-types scripts/windows-release-cli.ts build",
    "windows:inventory": "node --experimental-strip-types scripts/windows-release-cli.ts inventory",
    "windows:installer-smoke": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows-installer-smoke.ps1",
    "codex-adapter:smoke": "node --experimental-strip-types scripts/smoke-codex-adapter.ts",
    "codebuddy-adapter:smoke": "node --experimental-strip-types scripts/smoke-codebuddy-adapter.ts",
    "codebuddy-adapter:security-smoke": "node --experimental-strip-types scripts/security-smoke-codebuddy-adapter.ts",
    "codebuddy-adapter:lifecycle-smoke": "node --experimental-strip-types scripts/lifecycle-smoke-codebuddy-adapter.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:localized-copy": "node --experimental-strip-types scripts/check-localized-copy.ts",
    "test:cloudflare-free": "node --experimental-strip-types scripts/check-cloudflare-free-runtime.ts",
    "tauri:build": "node --experimental-strip-types scripts/tauri-build.ts && node --experimental-strip-types scripts/sign-app.ts",
    "tauri:build:app": "node --experimental-strip-types scripts/tauri-build.ts --bundles app && node --experimental-strip-types scripts/sign-app.ts",
    "tauri:build:release": "node --experimental-strip-types scripts/tauri-build.ts --release-flavor && node --experimental-strip-types scripts/sign-app.ts",
    "tauri:build:app:release": "node --experimental-strip-types scripts/tauri-build.ts --release-flavor --bundles app && node --experimental-strip-types scripts/sign-app.ts",
    "tauri:build:windows:shell": "node --experimental-strip-types scripts/tauri-build.ts --no-bundle",
    "package:mac:adhoc": "node --experimental-strip-types scripts/package-macos-adhoc.ts",
    "package:mac:adhoc:release": "TETI_BUILD_TYPE=release node --experimental-strip-types scripts/package-macos-adhoc.ts",
    "profile:create": "node --experimental-strip-types scripts/profile.ts create",
    "profile:status": "node --experimental-strip-types scripts/profile.ts status",
    "profile:preflight": "node --experimental-strip-types scripts/profile.ts preflight",
    "profile:clean": "node --experimental-strip-types scripts/profile.ts clean",
    "icon:generate": "node --experimental-strip-types scripts/generate-icon.ts",
    "icon:verify": "node --experimental-strip-types scripts/verify-icon-assets.ts",
    "build:diagnostics": "node --experimental-strip-types scripts/build-diagnostics.ts",
    "reset:first-launch": "node --experimental-strip-types scripts/reset-first-launch.ts",
    "reset:onboarding": "node --experimental-strip-types scripts/reset-first-launch.ts --onboarding-regression",
    "alpha:reset-local": "node --experimental-strip-types scripts/reset-first-launch.ts --alpha-local-reset",
    "rpc:path": "node --experimental-strip-types scripts/rpc.ts path",
    "rpc:install": "node --experimental-strip-types scripts/rpc.ts install",
    "rpc:verify": "node --experimental-strip-types scripts/rpc.ts verify",
    "bootstrap:mac": "node --experimental-strip-types scripts/bootstrap-mac.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide": "^1.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
