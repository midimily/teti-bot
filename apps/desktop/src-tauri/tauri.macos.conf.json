{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.teti/store-v2/task-attachments/input/**",
          "$HOME/.teti/store-v2/task-attachments/artifact/**"
        ]
      }
    }
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": {
      "resources/lifecycle-sidecar/main.mjs": "lifecycle-sidecar/main.mjs",
      "resources/lifecycle-sidecar/codex-image-runner.mjs": "lifecycle-sidecar/codex-image-runner.mjs",
      "resources/runtime/node": "runtime/node",
      "resources/runtime/deltachat-rpc-server": "runtime/deltachat-rpc-server"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
