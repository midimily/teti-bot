{
  "name": "teti-bot",
  "version": "0.4.2-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test apps/desktop/test/*.test.ts core/account/*.test.ts core/ai-status/*.test.ts core/application/*.test.ts core/callability/*.test.ts core/connection/*.test.ts core/delegation/*.test.ts core/environment/*.test.ts core/identity/*.test.ts core/observation/*.test.ts core/passport/*.test.ts core/task/*.test.ts integrations/chatmail/*.test.ts services/discovery/*.test.ts services/network/*.test.ts",
    "test:network:local": "node --experimental-strip-types --test --test-concurrency=1 services/network/integration/client.test.ts services/network/integration/identity.test.ts services/network/integration/presence.test.ts services/network/integration/profile.test.ts services/network/integration/relationship.test.ts apps/desktop/test/network-runtime.integration.ts",
    "test:cloudflare-free": "node --experimental-strip-types apps/desktop/scripts/check-cloudflare-free-runtime.ts",
    "test:security-recovery-rc": "node --experimental-strip-types --test core/workspace/*.test.ts core/delegation/*.test.ts core/task/*.test.ts apps/desktop/test/callable-adapter-kernel.test.ts apps/desktop/test/host-child-agent-core.test.ts apps/desktop/test/codex-callable-adapter.test.ts apps/desktop/test/codex-adapter-jsonl.test.ts apps/desktop/test/codex-image-output.test.ts apps/desktop/test/codebuddy-callability.test.ts apps/desktop/test/codebuddy-adapter-jsonl.test.ts apps/desktop/test/osaurus-connector.test.ts apps/desktop/test/osaurus-native-agent.test.ts apps/desktop/test/osaurus-runtime-identity.test.ts apps/desktop/test/loopback-http-transport.test.ts apps/desktop/test/workspace-store.test.ts apps/desktop/test/child-memory.test.ts apps/desktop/test/durable-execution-handle.test.ts apps/desktop/test/task-attachment-store.test.ts apps/desktop/test/task-transport-store.test.ts apps/desktop/test/peer-runtime.test.ts",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:tauri-dev": "npm --prefix apps/desktop run tauri:dev",
    "desktop:tauri-dev:windows": "npm --prefix apps/desktop run tauri:dev:windows",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:build:release": "npm --prefix apps/desktop run build:release",
    "desktop:runtime:windows:install-node": "npm --prefix apps/desktop run runtime:windows:install-node",
    "desktop:runtime:windows:stage-rpc": "npm --prefix apps/desktop run runtime:windows:stage-rpc --",
    "desktop:runtime:windows:verify": "npm --prefix apps/desktop run runtime:windows:verify",
    "desktop:runtime:windows:exit-gate": "npm --prefix apps/desktop run runtime:windows:exit-gate --",
    "desktop:build-machine:bootstrap": "npm --prefix apps/desktop run build-machine:bootstrap",
    "desktop:build-machine:hydrate": "npm --prefix apps/desktop run build-machine:hydrate",
    "desktop:build-machine:verify": "npm --prefix apps/desktop run build-machine:verify",
    "desktop:windows:release": "npm --prefix apps/desktop run windows:release",
    "desktop:windows:inventory": "npm --prefix apps/desktop run windows:inventory",
    "desktop:windows:installer-smoke": "npm --prefix apps/desktop run windows:installer-smoke --",
    "desktop:codex-adapter:smoke": "npm --prefix apps/desktop run codex-adapter:smoke",
    "desktop:codebuddy-adapter:smoke": "npm --prefix apps/desktop run codebuddy-adapter:smoke",
    "desktop:codebuddy-adapter:security-smoke": "npm --prefix apps/desktop run codebuddy-adapter:security-smoke",
    "desktop:codebuddy-adapter:lifecycle-smoke": "npm --prefix apps/desktop run codebuddy-adapter:lifecycle-smoke",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:i18n-check": "npm --prefix apps/desktop run check:localized-copy",
    "desktop:test": "node --experimental-strip-types --test apps/desktop/test/*.test.ts",
    "desktop:icon:generate": "npm --prefix apps/desktop run icon:generate",
    "desktop:icon:verify": "npm --prefix apps/desktop run icon:verify",
    "desktop:build-diagnostics": "npm --prefix apps/desktop run build:diagnostics",
    "desktop:reset-first-launch": "npm --prefix apps/desktop run reset:first-launch --",
    "desktop:reset-onboarding": "npm --prefix apps/desktop run reset:onboarding --",
    "desktop:alpha-reset-local": "npm --prefix apps/desktop run alpha:reset-local --",
    "desktop:rust-check": "npm --prefix apps/desktop exec tauri build -- --debug --no-bundle",
    "desktop:rust-check:windows": "node --experimental-strip-types apps/desktop/scripts/check-windows-shell.ts",
    "desktop:rust-fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:tauri-build": "npm --prefix apps/desktop run tauri:build",
    "desktop:tauri-build-app": "npm --prefix apps/desktop run tauri:build:app",
    "desktop:tauri-build:release": "npm --prefix apps/desktop run tauri:build:release",
    "desktop:tauri-build-app:release": "npm --prefix apps/desktop run tauri:build:app:release",
    "desktop:tauri-build:windows:shell": "npm --prefix apps/desktop run tauri:build:windows:shell",
    "desktop:package:mac:adhoc": "npm --prefix apps/desktop run package:mac:adhoc",
    "desktop:package:mac:adhoc:release": "npm --prefix apps/desktop run package:mac:adhoc:release",
    "desktop:profile:create": "npm --prefix apps/desktop run profile:create --",
    "desktop:profile:status": "npm --prefix apps/desktop run profile:status --",
    "desktop:profile:preflight": "npm --prefix apps/desktop run profile:preflight --",
    "desktop:profile:clean": "npm --prefix apps/desktop run profile:clean --",
    "desktop:rpc:path": "npm --prefix apps/desktop run rpc:path",
    "desktop:rpc:install": "npm --prefix apps/desktop run rpc:install",
    "desktop:rpc:verify": "npm --prefix apps/desktop run rpc:verify --",
    "desktop:bootstrap:mac": "npm --prefix apps/desktop run bootstrap:mac",
    "desktop:real-validation": "TETI_PROVISIONING_MODE=real TETI_ALLOW_REAL_PROVISIONING=1 npm --prefix apps/desktop run tauri:dev --"
  }
}
